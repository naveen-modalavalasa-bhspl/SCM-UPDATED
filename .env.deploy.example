# Copy to .env.deploy and replace every CHANGE_ME value before deployment.
APP_PORT=80

MYSQL_DATABASE=scm_erp
MYSQL_USER=scm_app
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# URL-encode special characters in MYSQL_PASSWORD when placing it in this URL.
DATABASE_URL=mysql+aiomysql://scm_app:CHANGE_ME_DATABASE_PASSWORD@db:3306/scm_erp

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Public browser origin, without a trailing slash.
CORS_ORIGINS=http://localhost

HCM_BASE_URL=https://CHANGE_ME_HCM_HOST/api
HCM_API_KEY=CHANGE_ME_HCM_API_KEY
HCM_TIMEOUT_SECONDS=5
HCM_RETRIES=3

# ---- Logins for HCM joiners ----
# The password an employee arriving from an HCM sync is given, so a new joiner can
# sign in without an admin cutting them a credential by hand. LEAVE IT UNSET and no
# login is created at all — which is a real choice, not an oversight: every account it
# makes shares one password. Every account created this way should be changed on first
# sign-in.
NEW_USER_DEFAULT_PASSWORD=

# ---- Mail ----
# Leave the SMTP block empty and the app runs exactly as before, except that "forgot
# password" quietly does nothing: it answers 204 either way (on purpose, so it cannot
# be used to test which accounts exist), so an unconfigured mailbox is invisible from
# the outside. Settings > Mail reports `can_send: false` when it is not set up.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=SCM ERP
MAIL_STARTTLS=true
MAIL_SMTP_SSL=false
# Reading the mailbox is a separate capability from sending to it. Unset = the Inbox
# tab says the mailbox is send-only instead of erroring.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SSL=true

# ---- Password reset ----
# Where a reset link points: the PUBLIC browser origin, opened by a person on their
# own machine. Defaults to CORS_ORIGINS, which is normally the same thing.
APP_BASE_URL=
# How long a link lives. Short on purpose: it is a bearer secret sitting in an inbox.
PASSWORD_RESET_MINUTES=30
# The only mail domain a reset link will be delivered to, e.g. bhspl.in. An address
# outside it is refused outright, so nobody can point an account's reset link at a
# mailbox the company does not control. Empty = no restriction.
PASSWORD_RESET_EMAIL_DOMAIN=
