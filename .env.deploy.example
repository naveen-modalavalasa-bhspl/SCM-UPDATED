# Copy to `.env` (next to compose.yaml) and replace every CHANGE_ME value before
# deploying. `.env` is what `docker compose up` reads on its own — no --env-file flag
# — and it is gitignored, so the real values never reach the repository.
#
# NOT backend/.env: that one is for running the backend directly on a developer's
# machine and is excluded from the image by backend/.dockerignore. Inside a container
# the ONLY settings that exist are the ones compose.yaml names in its `environment:`
# block and feeds from this file. A value that is not on that list does not reach the
# app, however correct it looks here — which is exactly how the mail settings and
# NEW_USER_DEFAULT_PASSWORD were silently missing until 2026-08-26.
APP_PORT=80

MYSQL_DATABASE=scm_erp
MYSQL_USER=scm_app
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# URL-encode special characters in MYSQL_PASSWORD when placing it in this URL.
DATABASE_URL=mysql+aiomysql://scm_app:CHANGE_ME_DATABASE_PASSWORD@db:3306/scm_erp

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Public browser origin, without a trailing slash.
CORS_ORIGINS=http://localhost

HCM_BASE_URL=https://CHANGE_ME_HCM_HOST/api
HCM_API_KEY=CHANGE_ME_HCM_API_KEY
HCM_TIMEOUT_SECONDS=5
HCM_RETRIES=3

# ---- Logins for HCM joiners ----
# The password an employee arriving from an HCM sync is given, so a new joiner can
# sign in without an admin cutting them a credential by hand. LEAVE IT UNSET and no
# login is created at all — which is a real choice, not an oversight: every account it
# makes shares one password. Every account created this way should be changed on first
# sign-in.
NEW_USER_DEFAULT_PASSWORD=

# ---- Mail ----
# Leave the SMTP block empty and the app runs exactly as before, except that "forgot
# password" quietly does nothing: it answers 204 either way (on purpose, so it cannot
# be used to test which accounts exist), so an unconfigured mailbox is invisible from
# the outside. Settings > Mail reports `can_send: false` when it is not set up.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=SCM ERP
MAIL_STARTTLS=true
MAIL_SMTP_SSL=false
# Reading the mailbox is a separate capability from sending to it. Unset = the Inbox
# tab says the mailbox is send-only instead of erroring.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SSL=true

# ---- Password reset ----
# Where a reset link points: the PUBLIC browser origin, opened by a person on their
# own machine. Defaults to CORS_ORIGINS, which is normally the same thing.
APP_BASE_URL=
# Where a printed label's QR code points: the PUBLIC address a phone opens from any
# network, e.g. https://scm.com. Empty = the address the printing browser is on.
PUBLIC_SCAN_URL=
# How long a link lives. Short on purpose: it is a bearer secret sitting in an inbox.
PASSWORD_RESET_MINUTES=30
# The only mail domain a reset link will be delivered to, e.g. bhspl.in. An address
# outside it is refused outright, so nobody can point an account's reset link at a
# mailbox the company does not control. Empty = no restriction.
PASSWORD_RESET_EMAIL_DOMAIN=

# --- Capacity and scale-out (added 2026-09-03) --------------------------------
# Read compose.yaml's header before changing any of these together.

# gunicorn workers PER container, and how many API containers nginx balances over.
# The DB pool is per worker, so max_connections in deploy/mysql.cnf must cover
# WEB_CONCURRENCY x BACKEND_REPLICAS x (DB_POOL_SIZE + DB_MAX_OVERFLOW) plus headroom.
# 5 x 2 x 30 = 300, against max_connections=500.
WEB_CONCURRENCY=5
BACKEND_REPLICAS=2
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Container memory. innodb_buffer_pool_size in deploy/mysql.cnf must stay at 50-70%
# of DB_MEMORY_LIMIT -- they are two halves of one decision, and a buffer pool larger
# than the limit is OOM-killed.
DB_MEMORY_LIMIT=4g
BACKEND_MEMORY_LIMIT=2g
WORKER_MEMORY_LIMIT=1g

# The shared cache and limiter. Defaults to the compose service; only set this to
# point at a Redis outside the stack.
# REDIS_URL=redis://redis:6379/0
PERMISSION_CACHE_SECONDS=300

# Login throttling.
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_PER_MINUTE=30

# /metrics, scraped from inside the compose network only (nginx returns 404 for it).
METRICS_ENABLED=true

# --- Backups ------------------------------------------------------------------
# BACKUP_HOST_DIR is the one that matters. Left at the default the dumps land in a
# named volume on the SAME HOST as the database they protect: that survives a dropped
# table and not a dead machine. Point it at mounted off-host storage.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
# BACKUP_HOST_DIR=/mnt/backups/scm-erp
