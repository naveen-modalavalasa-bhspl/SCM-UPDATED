{
  "name": "scm-erp-playwright-tests",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "End-to-end functional + non-functional browser tests for the SCM ERP web app.",
  "scripts": {
    "install:browsers": "playwright install chromium",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "PWDEBUG=1 playwright test",
    "report": "playwright show-report reports/html",
    "codegen": "playwright codegen http://localhost:5173"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2"
  }
}
