# Where the app is running. The frontend proxies /api to the backend, so BASE_URL
# alone is usually enough; API_URL is used for the direct API probes the tests make
# to follow an approval chain without clicking through every inbox.
BASE_URL=http://localhost:5173
API_URL=http://localhost:8000

# Non-functional thresholds. A request slower than SLOW_REQUEST_MS is logged as a
# performance finding; a page whose load exceeds SLOW_PAGE_MS is logged too.
SLOW_REQUEST_MS=1500
SLOW_PAGE_MS=3000

# Accessibility scan on every visited screen (axe-core). Slows a run by ~1s/page.
A11Y=true

# Screenshot every step, not just failures.
SCREENSHOT_EVERY_STEP=true

# Milliseconds between actions. 0 for CI; 300-600 makes a `npm run test:watch`
# run slow enough to follow with your eyes.
SLOW_MO=0

# ---------------------------------------------------------------- Indent module

# How many drafts the Indent module suite raises before it starts. Must stay above
# the list page size (20) or "page 2" is a control the run can never reach.
SEED_COUNT=24

# Whether the run may actually confirm a delivery on My deliveries. Confirming
# writes received quantities and can close a real indent; it cannot be undone.
# Left off, the run still opens the modal, checks its arithmetic, uploads and
# deletes a photo, and proves the no-photo rule by letting the server refuse.
ALLOW_DELIVERY_CONFIRM=false
