# ---- Database (MySQL only — there is no SQLite fallback) ----
# Create the schema in Workbench first:  CREATE DATABASE scm_erp;
# URL-encode special characters in the password:  # -> %23, @ -> %40, : -> %3A
DATABASE_URL=mysql+aiomysql://root:yourpassword@127.0.0.1:3306/scm_erp

# Where pytest builds its throwaway schema. Must be a MySQL your account can
# CREATE DATABASE on. WITHOUT THIS EVERY DB-BACKED TEST SILENTLY SKIPS.
TEST_DATABASE_URL=mysql+aiomysql://root:yourpassword@127.0.0.1:3306/scm_erp

# ---- Auth ----
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOW_DEMO_DATA=false

# ---- CORS (comma-separated) ----
CORS_ORIGINS=http://localhost:5173

# ---- HCM integration ----
HCM_BASE_URL=http://103.174.161.68:8001/api
HCM_API_KEY=sk_your_hcm_api_key
HCM_TIMEOUT_SECONDS=5
HCM_RETRIES=3

# Set true to let other machines on the local network reach the API.
# Uses a private-IP-range regex, never a wildcard, because the API sends credentials.
CORS_ALLOW_PRIVATE_NETWORK=false

# ---- Mail (SMTP out, IMAP in). All optional: unset = mail features say so and
#      nothing else changes. Never put these values in source. ----
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_USERNAME=scm@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=scm@example.com
MAIL_FROM_NAME=SCM ERP
MAIL_STARTTLS=true
MAIL_SMTP_SSL=false

# Only needed for the Inbox tab. Falls back to the SMTP credentials.
# MAIL_IMAP_HOST=imap.example.com
# MAIL_IMAP_PORT=993

# ---- Password reset ----
# The FRONTEND origin — the reset link is opened by a person in a browser.
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_MINUTES=30

# --- Audit trail: where an action was done from -------------------------------
# The Audit Log records the caller's IP and device from the request itself (no
# network call). Turning an IP into a place name needs an outside service, so it is
# configuration and not a literal in the code.
#
# Leave AUDIT_GEO_URL blank to switch location off entirely — the IP, browser, OS and
# device are still recorded, and every row simply shows no location.
# `{ip}` is substituted with the caller's address.
AUDIT_GEO_URL=http://ip-api.com/json/{ip}
AUDIT_GEO_TIMEOUT=2.5
# A private/LAN address has no public location. `true` asks the service for THIS
# SERVER's location instead, which is the right answer for an on-site deployment
# where the users are in the building, and the wrong one for anyone connecting from
# elsewhere. Set false to leave those rows' location blank.
AUDIT_GEO_PRIVATE_IPS=true
