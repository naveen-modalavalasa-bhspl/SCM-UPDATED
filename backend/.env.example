# ---- Database (MySQL only — there is no SQLite fallback) ----
# Create the schema in Workbench first:  CREATE DATABASE scm_erp;
# URL-encode special characters in the password:  # -> %23, @ -> %40, : -> %3A
DATABASE_URL=mysql+aiomysql://root:yourpassword@127.0.0.1:3306/scm_erp

# Where pytest builds its throwaway schema. Must be a MySQL your account can
# CREATE DATABASE on. WITHOUT THIS EVERY DB-BACKED TEST SILENTLY SKIPS.
TEST_DATABASE_URL=mysql+aiomysql://root:yourpassword@127.0.0.1:3306/scm_erp

# ---- Auth ----
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOW_DEMO_DATA=false

# ---- CORS (comma-separated) ----
CORS_ORIGINS=http://localhost:5173

# ---- HCM integration ----
HCM_BASE_URL=http://103.174.161.68:8001/api
HCM_API_KEY=sk_your_hcm_api_key
HCM_TIMEOUT_SECONDS=5
HCM_RETRIES=3

# Set true to let other machines on the local network reach the API.
# Uses a private-IP-range regex, never a wildcard, because the API sends credentials.
CORS_ALLOW_PRIVATE_NETWORK=false

# ---- Mail (SMTP out, IMAP in). All optional: unset = mail features say so and
#      nothing else changes. Never put these values in source. ----
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_USERNAME=scm@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=scm@example.com
MAIL_FROM_NAME=SCM ERP
MAIL_STARTTLS=true
MAIL_SMTP_SSL=false

# Only needed for the Inbox tab. Falls back to the SMTP credentials.
# MAIL_IMAP_HOST=imap.example.com
# MAIL_IMAP_PORT=993

# ---- Road distances for the Smart Load Planner. Optional: unset = distances are
#      ESTIMATED (straight line x road factor) and labelled so on screen. ----
# An OSRM server exposing /table/v1/{profile}. Self-host it (OSRM built from the
# southern-zone OpenStreetMap extract); the public demo server forbids heavy use.
# ROUTING_OSRM_URL=http://osrm:5000
# ROUTING_PROFILE=driving
# ROUTING_TIMEOUT_SECONDS=8
# ROUTING_CACHE_DAYS=90

# ---- Password reset ----
# The FRONTEND origin — the reset link is opened by a person in a browser.
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_MINUTES=30

# --- Audit trail: where an action was done from -------------------------------
# The Audit Log records the caller's IP and device from the request itself (no
# network call). Turning an IP into a place name needs an outside service, so it is
# configuration and not a literal in the code.
#
# Leave AUDIT_GEO_URL blank to switch location off entirely — the IP, browser, OS and
# device are still recorded, and every row simply shows no location.
# `{ip}` is substituted with the caller's address.
AUDIT_GEO_URL=http://ip-api.com/json/{ip}
AUDIT_GEO_TIMEOUT=2.5
# A private/LAN address has no public location. `true` asks the service for THIS
# SERVER's location instead, which is the right answer for an on-site deployment
# where the users are in the building, and the wrong one for anyone connecting from
# elsewhere. Set false to leave those rows' location blank.
AUDIT_GEO_PRIVATE_IPS=true

# --- Capacity: connection pool, cache, workers (added 2026-09-03) --------------
#
# The pool is PER WORKER PROCESS. The defaults below are the DEVELOPMENT numbers and
# are deliberately small: several developers point their own uvicorn at one shared
# MySQL capped at 151 connections, and 20+10 each exhausts it. Production sets 20/10
# in .env.deploy and raises the server's max_connections to cover
# workers x replicas x (size + overflow) plus headroom -- see deploy/mysql.cnf.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# The shared cache, rate limiter and cross-worker state. LEAVE BLANK locally: every
# user of it falls back to a per-process dict with the same behaviour, so nothing has
# to be installed. Set it wherever more than one worker runs -- an in-process rate
# limiter multiplies the configured ceiling by the number of workers.
# REDIS_URL=redis://127.0.0.1:6379/0

# How long a resolved permission set is cached across requests. This is now the lag
# between an admin revoking a grant and the revocation biting, so keep it under 15
# minutes. A grant write drops the cache outright; this is only the backstop.
PERMISSION_CACHE_SECONDS=300

# The HCM sync and the approval reminders. TRUE in a single local process; FALSE on
# every web worker in a multi-worker deployment, where exactly one dedicated worker
# container sets it true. Two schedulers means two concurrent HCM syncs and every
# reminder delivered twice to a real person.
RUN_SCHEDULERS=true

# --- Login throttling ---------------------------------------------------------
# Per account, then per address. Both were absent until 2026-09-03: the lockout
# columns existed and nothing incremented them, and the endpoint runs a ~300 ms
# bcrypt, so an unmetered login is a denial-of-service button as much as a
# credential risk.
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_PER_MINUTE=30

# --- Observability ------------------------------------------------------------
# Per-endpoint latency, throughput, error rate and a connection-pool gauge on
# /metrics. Unauthenticated and it names every route, so the proxy does not forward
# it -- scrape the backend directly from inside the network.
METRICS_ENABLED=false

# ---- Organisation directory (Settings > Organisation Masters) ----
# A separate feed from HCM, with its own key. Optional: unset, the two tabs say so and
# nothing else changes.
ORG_SYNC_URL=http://your-host:8000/api/sync-payload/data/
ORG_SYNC_API_KEY=sk_your_org_sync_key
# The organisation a new document opens on, by name. People can still pick another.
ORG_DEFAULT_NAME=BAVYA
