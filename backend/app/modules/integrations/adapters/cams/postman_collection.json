{
  "info": {
    "name": "SCM → B-CAMS (cams integration)",
    "description": "All 14 read feeds, the 5 write endpoints, and the SCM-side console routes.\n\nSet the collection variables first: base, apiKey, jwt.\n\nBody signing was removed on 2026-09-01 — the API key is the whole credential and X-CAMS-Signature is not read. A collection-level pre-request script still stamps a fresh event_id, so a re-send is a NEW event. To test idempotency, disable the script line that regenerates eventId (or just send the same request twice with `{{eventId}}` pinned to a literal).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "jwt",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Only the write requests carry a body worth signing.",
          "const raw = pm.request.body && pm.request.body.raw;",
          "if (!raw) { return; }",
          "",
          "// A unique event_id per send, so each POST is a new event rather than a replay.",
          "// Comment the next line out to test idempotency: the same id twice must answer",
          "// {\"ok\":true,\"duplicate\":true}.",
          "pm.collectionVariables.set('eventId', 'pm-' + Date.now() + '-' + Math.random().toString(16).slice(2, 10));",
          "",
          "// Bodies are no longer signed (2026-09-01): X-CAMS-Signature is not read."
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('status is 2xx', () => pm.response.to.be.success);",
          "const body = pm.response.json();",
          "if (Array.isArray(body.items)) {",
          "  pm.test('envelope has items/total/page/page_size', () => {",
          "    pm.expect(body).to.have.property('total');",
          "    pm.expect(body).to.have.property('page');",
          "    pm.expect(body).to.have.property('page_size');",
          "  });",
          "  console.log(pm.info.requestName + ' → total=' + body.total);",
          "}"
        ]
      }
    }
  ],
